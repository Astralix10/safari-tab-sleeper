{
  "manifest_version": 3,
  "name": "Safari Tab Sleeper",
  "version": "0.2.0",
  "description": "Усыпляет неактивные вкладки Safari, восстанавливает их при выборе и чистит тяжёлые вкладки при давлении на память.",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Усыпить вкладки"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/page-guard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  }
}
